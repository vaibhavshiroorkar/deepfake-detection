# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Datasets and media — data/ holds only manifests and splits in git.
# Raw videos/audio/frames stay local. Un-ignore specific manifest files as needed.
data/*
!data/.gitkeep
!data/*.csv
!data/*.json
!data/*.md
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.wav
*.flac
*.mp3

# Extracted frames and features
frames/
features/
*.npy
*.npz

# Model artifacts. The selected checkpoint of each stream is the exception: it
# is tracked through Git LFS (see .gitattributes) so a clone can run the
# dashboard without retraining. Everything else -- last.pt, the superseded
# best_*.pt -- stays local, and last.pt could not be pushed anyway at ~300 MB.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
checkpoints/**
!checkpoints/*/
!checkpoints/*/best.pt
# YuNet's weights are a dependency, not a training artifact: 232 KB, never
# retrained, and detection cannot run without them. Tracked in git directly
# rather than LFS at that size.
!checkpoints/yunet/*.onnx
runs/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local Project Overrides
output_crops/
sample_videos/

# Training run logs. Tracked: they are the record of how the checkpoints beside
# them were produced, which is worth keeping now that the checkpoints ship too.
